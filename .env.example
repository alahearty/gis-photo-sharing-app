# ASP.NET Core reads process environment variables directly. This file is documentation only;
# the application does not auto-load .env files.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
DatabaseProvider=Sqlite
UseInMemoryDatabase=false
ConnectionStrings__SqliteConnection=Data Source=gis_photo_sharing_app.db
Jwt__Key=<replace-with-a-randomly-generated-secret>
Jwt__Issuer=gis-photo-sharing-app
Jwt__Audience=gis-photo-sharing-app

# Development-only demonstration seeds (disabled by default in production)
DatabaseSeed__DefaultUser=true
DatabaseSeed__SamplePhotos=true

# Local HTTP development does not redirect to HTTPS
Https__RedirectEnabled=false

# Map defaults (Port Harcourt)
MapSettings__DefaultLatitude=4.8156
MapSettings__DefaultLongitude=7.0498
MapSettings__DefaultZoom=12

# Optional dedicated media storage
# PhotoSettings__StorageRoot=D:\GISPhotoShareData\media

# Optional reverse geocoding
# Geocoding__Enabled=true
# Geocoding__BaseUrl=https://nominatim.openstreetmap.org/
# Geocoding__UserAgent=GISPhotoShare/1.0

# Optional SQL Server alternative
# DatabaseProvider=SqlServer
# ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=gis_photo_sharing_app;Trusted_Connection=True;MultipleActiveResultSets=true

# Isolated tests may use the in-memory provider:
# UseInMemoryDatabase=true
