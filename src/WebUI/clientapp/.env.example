# API base URL when running the Vue dev server separately.
# Leave empty when the API serves the built SPA (requests stay same-origin and use the proxy).
# VUE_APP_API_URL=https://localhost:5001

# Target used by the Vue CLI dev-server proxy for /api and /uploads.
# Defaults to IIS Express; for Kestrel on 5001 use:
# VUE_APP_DEV_API_TARGET=https://localhost:5001
