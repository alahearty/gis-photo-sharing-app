{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=gis_photo_sharing_app;Trusted_Connection=True;MultipleActiveResultSets=true",
    "SqliteConnection": "Data Source=gis_photo_sharing_app.db"
  },
  "DatabaseProvider": "Sqlite",
  "UseInMemoryDatabase": false,
  "DatabaseSeed": {
    "DefaultUser": false,
    "SamplePhotos": false
  },
  "Https": {
    "RedirectEnabled": true
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "MapSettings": {
    "DefaultLatitude": 4.8156,
    "DefaultLongitude": 7.0498,
    "DefaultZoom": 12,
    "MinimumZoom": 3,
    "MaximumZoom": 19,
    "DefaultLocationName": "Port Harcourt, Rivers State, Nigeria",
    "Layers": [
      {
        "Name": "OpenStreetMap",
        "UrlTemplate": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "Attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" rel=\"noopener noreferrer\">OpenStreetMap</a> contributors",
        "MaximumZoom": 19,
        "IsDefault": true
      },
      {
        "Name": "OpenTopoMap",
        "UrlTemplate": "https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png",
        "Attribution": "Map data &copy; <a href=\"https://www.openstreetmap.org/copyright\" rel=\"noopener noreferrer\">OpenStreetMap</a> contributors, style &copy; <a href=\"https://opentopomap.org/\" rel=\"noopener noreferrer\">OpenTopoMap</a>",
        "MaximumZoom": 17,
        "IsDefault": false
      },
      {
        "Name": "Esri World Imagery",
        "UrlTemplate": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
        "Attribution": "Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community",
        "MaximumZoom": 19,
        "IsDefault": false
      }
    ]
  },
  "PhotoSettings": {
    "MaxUploadBytes": 10485760,
    "MaxImagePixels": 50000000,
    "MaxImageDimension": 12000,
    "ThumbnailSize": 360,
    "MaximumImageWidth": 2560,
    "Categories": [
      "General",
      "Landscape",
      "Buildings",
      "Roads",
      "Environment",
      "Tourism",
      "Infrastructure",
      "Other"
    ],
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp"
    ]
  },
  "Geocoding": {
    "Enabled": true,
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "UserAgent": "GISPhotoShare/1.0",
    "Attribution": "Geocoding © OpenStreetMap contributors (Nominatim)",
    "MinimumIntervalMilliseconds": 1100,
    "TimeoutSeconds": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "dev-secret-key-min-32-chars-long!!",
    "Issuer": "gis-photo-sharing-app",
    "Audience": "gis-photo-sharing-app"
  }
}
